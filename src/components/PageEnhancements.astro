---
import guide from '../data/guide-pages.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const chapters = guide.pages.filter((page) => !page.parent);
---

<div class="scroll-progress" aria-hidden="true"><span></span></div>

<div class="chapter-jump" data-chapter-jump>
  <nav aria-label="Nhảy nhanh tới chương">
    <ol>
      {chapters.map((chapter) => (
        <li>
          <a
            href={`${base}#${chapter.id}`}
            data-chapter-link={chapter.id}
            data-chapter-number={chapter.number}
            data-chapter-title={chapter.title}
          >
            <span>{chapter.number}</span>
            <strong>{chapter.title}</strong>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</div>

<a
  class="back-to-top"
  href="#_top"
  aria-label="Về đầu trang"
  aria-hidden="true"
  tabindex="-1"
  title="Về đầu trang"
>
  <span aria-hidden="true">↑</span>
</a>

<div class="image-lightbox" aria-modal="true" aria-hidden="true" role="dialog" aria-label="Xem ảnh to">
  <button type="button" class="image-lightbox__close" aria-label="Đóng">×</button>
  <button type="button" class="image-lightbox__nav image-lightbox__nav--prev" aria-label="Ảnh trước">‹</button>
  <img alt="" loading="eager" />
  <button type="button" class="image-lightbox__nav image-lightbox__nav--next" aria-label="Ảnh sau">›</button>
  <div class="image-lightbox__caption"></div>
  <div class="image-lightbox__counter"><span data-lightbox-current>1</span> / <span data-lightbox-total>1</span></div>
</div>

<script>
  function copyText(value: string) {
    if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
    return Promise.reject(new Error('Clipboard API không khả dụng'));
  }

  function enhanceOriginalPost() {
    const article = document.querySelector<HTMLElement>('.original-post');
    if (!article || article.dataset.enhanced === 'true') return;
    article.dataset.enhanced = 'true';

    article.querySelectorAll('.bbCodeBlock--code').forEach((block) => {
      const code = block.querySelector('code');
      const title = block.querySelector('.bbCodeBlock-title');
      if (!code || !title) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'original-code-copy';
      button.textContent = 'Sao chép';
      button.setAttribute('aria-label', 'Sao chép đoạn mã');
      button.addEventListener('click', async () => {
        try {
          await copyText(code.textContent || '');
          button.textContent = 'Đã chép ✓';
        } catch {
          button.textContent = 'Không thể chép';
        }
        window.setTimeout(() => { button.textContent = 'Sao chép'; }, 1800);
      });
      title.append(button);
    });

    article.querySelectorAll('.bbTable').forEach((table, index) => {
      table.setAttribute('role', 'region');
      table.setAttribute('tabindex', '0');
      table.setAttribute('aria-label', `Bảng dữ liệu ${index + 1} — có thể cuộn ngang`);
    });

    article.querySelectorAll('.optimized-media').forEach((img) => {
      const image = img as HTMLImageElement;
      if (image.complete) {
        image.dataset.loaded = 'true';
      } else {
        image.addEventListener('load', () => { image.dataset.loaded = 'true'; });
        image.addEventListener('error', () => { image.dataset.loaded = 'true'; });
      }
    });
  }

  function enhanceImageZoom() {
    const lightbox = document.querySelector<HTMLElement>('.image-lightbox');
    if (!lightbox) return;
    const lightboxImg = lightbox.querySelector('img');
    const closeButton = lightbox.querySelector<HTMLElement>('.image-lightbox__close');
    const prevButton = lightbox.querySelector<HTMLElement>('.image-lightbox__nav--prev');
    const nextButton = lightbox.querySelector<HTMLElement>('.image-lightbox__nav--next');
    const captionEl = lightbox.querySelector<HTMLElement>('.image-lightbox__caption');
    const currentEl = lightbox.querySelector<HTMLElement>('[data-lightbox-current]');
    const totalEl = lightbox.querySelector<HTMLElement>('[data-lightbox-total]');
    if (!lightboxImg || !closeButton || !prevButton || !nextButton || !captionEl || !currentEl || !totalEl || lightbox.dataset.enhanced === 'true') return;
    lightbox.dataset.enhanced = 'true';

    const images: HTMLImageElement[] = [];
    let currentIndex = 0;

    document.querySelectorAll<HTMLImageElement>('.bbImage:not(.smilie)').forEach((img) => {
      images.push(img);
    });

    const updateCounter = () => {
      currentEl.textContent = String(currentIndex + 1);
      totalEl.textContent = String(images.length);
    };

    const loadImage = (src: string): Promise<void> => {
      return new Promise((resolve) => {
        if (!src) { resolve(); return; }
        const temp = new Image();
        temp.onload = () => resolve();
        temp.onerror = () => resolve();
        temp.src = src;
      });
    };

    const showImage = async (index: number) => {
      currentIndex = index;
      const img = images[index];
      if (!img) return;
      const fullSrc = img.dataset.originalSrc || img.src;
      const alt = img.alt || img.title || '';

      lightboxImg.classList.remove('image-lightbox__img--loaded');
      lightbox.classList.add('is-loading');

      await loadImage(fullSrc);
      lightboxImg.src = fullSrc;
      lightboxImg.alt = alt;
      captionEl.textContent = alt || '';
      updateCounter();

      lightboxImg.onload = () => {
        lightboxImg.classList.add('image-lightbox__img--loaded');
        lightbox.classList.remove('is-loading');
      };
      lightboxImg.onerror = () => {
        lightbox.classList.remove('is-loading');
      };
    };

    const openLightbox = (index: number) => {
      if (images.length === 0) return;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      showImage(index).then(() => { prevButton.focus(); });
    };

    const closeLightbox = () => {
      lightbox.classList.remove('is-open', 'is-loading');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImg.src = '';
      lightboxImg.alt = '';
      lightboxImg.classList.remove('image-lightbox__img--loaded');
      captionEl.textContent = '';
      document.body.style.overflow = '';
    };

    const prev = () => {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      showImage(currentIndex).then(() => { prevButton.focus(); });
    };

    const next = () => {
      currentIndex = (currentIndex + 1) % images.length;
      showImage(currentIndex).then(() => { nextButton.focus(); });
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('.image-lightbox')) return;
      const img = target.closest<HTMLImageElement>('.bbImage:not(.smilie)');
      if (!img) return;
      const idx = images.indexOf(img);
      if (idx < 0) return;
      event.preventDefault();
      openLightbox(idx);
    });

    closeButton.addEventListener('click', closeLightbox);
    prevButton.addEventListener('click', prev);
    nextButton.addEventListener('click', next);

    lightbox.addEventListener('click', (event) => {
      if ((event.target as HTMLElement) === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (event.key === 'Escape') closeLightbox();
      else if (event.key === 'ArrowLeft') prev();
      else if (event.key === 'ArrowRight') next();
    });
  }

  function enhanceChapterNavigation() {
    const article = document.querySelector<HTMLElement>('.original-post');
    const jump = document.querySelector<HTMLElement>('[data-chapter-jump]');
    if (!article || !jump || jump.dataset.enhanced === 'true') return;
    jump.dataset.enhanced = 'true';

    const sections = Array.from(article.querySelectorAll<HTMLElement>('.original-chapter'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'));
    let activeId = '';

    function setActiveChapter(id = '') {
      if (activeId === id) return;
      activeId = id;

      links.forEach((link) => {
        const active = link.dataset.chapterLink === id;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }

    function syncFromPosition() {
      const readingLine = Math.min(window.innerHeight * 0.28, 240);
      const current = sections.find((section) => {
        const bounds = section.getBoundingClientRect();
        return bounds.top <= readingLine && bounds.bottom > readingLine;
      });
      const heading = current?.querySelector<HTMLElement>('.original-chapter-heading');
      setActiveChapter(heading?.id || '');
    }

    let navigationScheduled = false;
    function scheduleNavigationSync() {
      if (navigationScheduled) return;
      navigationScheduled = true;
      window.requestAnimationFrame(() => {
        syncFromPosition();
        navigationScheduled = false;
      });
    }

    const Observer = globalThis.IntersectionObserver;
    if (Observer) {
      const observer = new Observer(scheduleNavigationSync, {
        rootMargin: '-22% 0px -68% 0px',
        threshold: 0,
      });
      sections.forEach((section) => observer.observe(section));
    }
    window.addEventListener('scroll', scheduleNavigationSync, { passive: true });
    window.addEventListener('resize', scheduleNavigationSync, { passive: true });

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const targetId = link.dataset.chapterLink;
        const target = targetId ? document.getElementById(targetId) : null;
        const targetSection = target?.closest<HTMLElement>('.original-chapter');
        const targetIndex = targetSection ? sections.indexOf(targetSection) : -1;
        const measuredSections = targetIndex >= 0 ? sections.slice(0, targetIndex + 1) : [];
        if (!target) return;

        // Các chương dùng content-visibility để giữ trang nhẹ. Đo những chương đứng
        // trước đích trong một nhịp giúp fragment xa không dừng ở vị trí ước lượng.
        event.preventDefault();
        measuredSections.forEach((section) => {
          section.style.contentVisibility = 'visible';
        });
        window.history.pushState(null, '', link.href);
        const previousScrollBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        target.scrollIntoView({ block: 'start' });
        window.requestAnimationFrame(() => {
          target.scrollIntoView({ block: 'start' });
          window.requestAnimationFrame(() => {
            target.scrollIntoView({ block: 'start' });
            document.documentElement.style.scrollBehavior = previousScrollBehavior;
            syncFromPosition();
          });
        });

        syncFromPosition();
      });
    });

    syncFromPosition();
  }

  function enhanceScrollControls() {
    const progress = document.querySelector<HTMLElement>('.scroll-progress span');
    const backToTop = document.querySelector<HTMLAnchorElement>('.back-to-top');
    if (!progress || !backToTop || backToTop.dataset.enhanced === 'true') return;
    const progressBar = progress;
    const backToTopLink = backToTop;
    backToTopLink.dataset.enhanced = 'true';
    let scheduled = false;

    function update() {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progressBar.style.setProperty('--guide-scroll-progress', String(ratio));

      const visible = window.scrollY > Math.min(window.innerHeight * 0.8, 720);
      backToTopLink.classList.toggle('is-visible', visible);
      backToTopLink.setAttribute('aria-hidden', String(!visible));
      backToTopLink.tabIndex = visible ? 0 : -1;
      scheduled = false;
    }

    window.addEventListener('scroll', () => {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  function enhancePage() {
    enhanceOriginalPost();
    enhanceChapterNavigation();
    enhanceScrollControls();
    enhanceImageZoom();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enhancePage, { once: true });
  } else {
    enhancePage();
  }
</script>
