---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import type { GuidePage } from '../utils/guide-format';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const guideUntyped = JSON.parse(readFileSync(path.resolve('src/data/guide-pages.json'), 'utf8'));
const guide = guideUntyped as { pages: GuidePage[]; verifiedAt: string };
const currentId = Astro.url.hash?.slice(1) || '';
---

<nav class="breadcrumb" aria-label="Đường đi hiện tại">
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      <a href={base} class="breadcrumb__link">Lộ trình</a>
    </li>
    {currentId ? (
      <>
        <li class="breadcrumb__separator" aria-hidden="true">/</li>
        <li class="breadcrumb__item">
          <span class="breadcrumb__current">{(() => {
            const match = currentId.match(/^(-?\d+(?:\.\d+)*)-/);
            if (match) {
              const num = match[1];
              const page = guide.pages.find(p => p.number === num);
              return page?.title || num;
            }
            const page = guide.pages.find(p => p.id === currentId);
            return page?.title || currentId;
          })()}</span>
        </li>
      </>
    ) : ''}
  </ol>
</nav>
