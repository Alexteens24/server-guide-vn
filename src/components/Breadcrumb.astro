---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import type { GuidePage } from '../utils/guide-format';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const guideUntyped = JSON.parse(readFileSync(path.resolve('src/data/guide-pages.json'), 'utf8'));
const guide = guideUntyped as { pages: GuidePage[]; verifiedAt: string };

const breadcrumbTitles: Record<string, string> = {};
for (const page of guide.pages) {
  breadcrumbTitles[page.id] = page.title;
  if (page.number) breadcrumbTitles[page.number] = page.title;
}
---

<nav class="breadcrumb" aria-label="Đường đi hiện tại">
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      <a href={base} class="breadcrumb__link">Lộ trình</a>
    </li>
    <li class="breadcrumb__separator" aria-hidden="true">/</li>
    <li class="breadcrumb__item">
      <span class="breadcrumb__current" data-breadcrumb-current>…</span>
    </li>
  </ol>
</nav>

<script type="application/json" data-breadcrumb-titles is:inline>{JSON.stringify(breadcrumbTitles)}</script>
<script is:inline type="module">
  (function() {
    const titlesEl = document.querySelector('[data-breadcrumb-titles]');
    const titles = titlesEl ? JSON.parse(titlesEl.textContent) : {};
    const currentEl = document.querySelector('[data-breadcrumb-current]');
    if (!currentEl) return;

    function updateFromHash() {
      const hash = window.location.hash;
      const id = hash.startsWith('#') ? hash.slice(1) : '';
      if (!id) {
        currentEl.textContent = 'Toàn bộ lộ trình';
        return;
      }
      const match = id.match(/^(-?\d+(?:\.\d+)*)-/);
      if (match) {
        const num = match[1];
        const title = titles[num] || titles[id] || num;
        currentEl.textContent = title;
      } else {
        const title = titles[id] || id;
        currentEl.textContent = title;
      }
    }

    updateFromHash();
    window.addEventListener('hashchange', updateFromHash);
  })();
</script>
